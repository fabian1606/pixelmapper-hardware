menu "Pixelmapper Node: Ethernet (pm_net)"

    comment "All Ethernet pins (RMII, MDC/MDIO, PHY reset/address, REF_CLK) come from pm_board."

    config PM_NET_PKTINFO
        bool
        default y
        select LWIP_NETBUF_RECVINFO
        help
            IP_PKTINFO on the Art-Net socket: pm_artnet needs the destination address of each datagram
            (ArtSync is accepted only as broadcast).

    config PM_NET_TASK_PRIO
        int "Network task priority"
        default 10
    config PM_NET_TASK_STACK
        int "Network task stack size"
        default 6144
    config PM_NET_POST_QUEUE_LEN
        int "pm_net_post queue length"
        default 32
endmenu
